# Copy to .env. Everything is optional; the default runs against the live Stord site.

# BASE_URL=https://www.stord.com

# Run with a visible browser, optionally slowed down (ms between actions)
# HEADED=true
# SLOW_MO=300

# Slack notifications
# SLACK_NOTIFY=true
# SLACK_WEBHOOK_FAILURES=
# SLACK_WEBHOOK_REGRESSION=
